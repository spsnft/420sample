# Required in production — set this to the real domain there. Everywhere
# else (a Vercel preview, a local checkout) it's fine to leave unset: the app
# falls back to that deployment's own address (NEXT_PUBLIC_VERCEL_URL, then
# localhost) so a preview build's QR/invite links and metadata never point
# at production or at some other preview. See config/site.ts.
NEXT_PUBLIC_APP_URL=https://buds.digital
NEXT_PUBLIC_SITE_NAME=Buds Digital
NEXT_PUBLIC_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Required for the /staff compliance tool (client/prescription/purchase tracking).
# See supabase/README.md for how to create the project and run the migration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Powers the "Live Demo" button on buds.digital (see supabase/README.md,
# "Demo login for buds.digital"). Must be an existing Supabase Auth
# user with a matching row in public.staff (supabase/seed.sql creates one).
# Leave unset on real client instances — the button shows a friendly
# "not configured" message instead of failing.
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=

# Set to "1" only on the buds.digital demo instance. When set, middleware.ts
# signs an unauthenticated /staff visitor in as the demo account above
# instead of redirecting to /staff/login — so a bare /staff link never shows
# a prospect a login form. Leave unset everywhere else (including real
# client instances): auth then behaves exactly as it does without this flag.
DEMO_AUTO_LOGIN=

# Powers the "Request a Free Consultation" form on the homepage. Notifies
# staff via a push message from the business's official LINE account, using
# the LINE Messaging API (LINE Notify was shut down by LINE in March 2025 —
# do not use it, this is the official replacement).
# - LINE_CHANNEL_ACCESS_TOKEN: long-lived channel access token from the
#   LINE Developers console for the business's Messaging API channel.
# - LINE_STAFF_USER_ID: the LINE user/group ID that should receive the push
#   (add the official account as a friend, or invite it to a staff group,
#   then read the ID from the webhook event or LINE Official Account Manager).
# Leave unset to disable the form's backend — submissions will fail with a
# friendly error instead of silently dropping.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_STAFF_USER_ID=
